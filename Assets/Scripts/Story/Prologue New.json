—","\n","#","^speaker: Boss","/#","^Are you accusing someone?","\n","^Are you accusing ME?","\n","^In front of OUR CLIENT?","\n","#","^speaker: Itsuki","/#","^N-no! I just—","\n","#","^speaker: Boss","/#","^Enough.","\n","^Security. Escort him out.","\n","^And Itsuki — don't even think about asking for a reference.","\n","#","^speaker: Itsuki","/#","^...but I...","\n","^(the room is spinning again)","\n","^(it's happening again)","\n","^(I did everything right this time...)","\n","^(I DID EVERYTHING RIGHT—)","\n",{"->":"case1_goHome"},{"#f":1}],"fired":["#","^speaker: Boss","/#","^Ohohoho...","\n","^Tough luck, Itsuki.","\n","^You're,","\n","^F I R E D !","\n","#","^speaker: Itsuki","/#","ev",true,"/ev",{"VAR=":"Sad","re":true},"^NO. No, no, no...","\n","^B-boss, please.","\n","^Give me another chance.","\n","^I'll be your footrest. I can massage your—","\n","^I can sleep here! I won't close my eyes ever again, I swear—","\n","#","^speaker: Boss","/#","^Rules are rules, Itsuki.","\n","^GET OUT!!!","\n","#","^speaker: Itsuki","/#","^B-but my rent—","\n","^I took YEARS to get accepted here—","\n","^Please—","\n","#","^speaker: Boss","/#","^SECURITY!!!","\n","^Intruder alert!!!","\n","#","^speaker: Itsuki","/#","^...","\n","^Fine.","\n","^I'm going. I'm going.","\n","ev",false,"/ev",{"VAR=":"Sad","re":true},"ev",true,"/ev",{"VAR=":"Depressed","re":true},{"->":"case1_goHome"},{"#f":1}],"case1_goHome":["ev","str","^quest_go_home","/str",{"x()":"SetFlag","exArgs":1},"pop","/ev","\n","#","^speaker: Itsuki","/#","^(The streets are the same streets I walk every day.)","\n","^(Same vending machine. Same stray cat. Same cracked pavement.)","\n","^(Nothing has changed.)","\n","^(And yet everything is over.)","\n",{"->":"case1_ramen"},{"#f":1}],"case1_ramen":["#","^speaker: Itsuki","/#","ev",true,"/ev",{"VAR=":"Depressed","re":true},"^I lost my parents.","\n","^My brother won't even acknowledge me.","\n","^And now...","\n","^I lost the job it took me years to get.","\n","^...","\n","^Is anything still worth a try?","\n","#","^speaker: Itsuki","/#","^...","\n","^Ah.","\n","^Chef Tan's.","\n","^I guess I'll pay him one last visit.","\n","#","^speaker: Itsuki","/#","^Hey, Chef Tan.","\n","^The usual, please.","\n","#","^speaker: Chef Tan","/#","^Right away—","\n","^...","\n","^Kid. Sit down.","\n","^You're wearing your bad aura all over your face.","\n","^Talk to your old man.","\n","#","^speaker: Itsuki","/#","^...I got fired.","\n","#","^speaker: Chef Tan","/#","^Ah. You got—","\n","^Wait. FIRED? Why?!","\n","#","^speaker: Itsuki","/#","^I closed my eyes for a second.","\n","^After weeks of overtime because of my boss.","\n","^I did everything for that company.","\n","^He took all the credit.","\n","^And I couldn't fight him. None of us could.","\n","#","^speaker: Chef Tan","/#","^...","\n","^Sigh.","\n","^I warned you. Four, five years ago.","\n","^That company eats people, I said.","\n","^\"You watch yourself, Itsuki,\" I said.","\n","^And you kept telling me you were fine.","\n","^Nothing bad would happen to you.","\n","^...Now look at you.","\n","^Do you believe me now?","\n","#","^speaker: Itsuki","/#","^...","\n","^Yeah.","\n","^I believe you.","\n","#","^speaker: Chef Tan","/#","^Kid. Listen to me.","\n","^A job is a job. It's not your life.","\n","^You're still breathing. You hear me?","\n","^As long as you're breathing, the story isn't over.","\n","^Come by tomorrow. I'll teach you the soup recipe.","\n","^You can start over. People do it all the time.","\n","#","^speaker: Itsuki","/#","ev",true,"/ev",{"VAR=":"Happy","re":true},"^...","\n","^Heh.","\n","^You'd really do that? For a failure like me?","\n","#","^speaker: Chef Tan","/#","^Hah! For Itsuki who always pays his bill and tips too much?","\n","^Any day of the week.","\n","#","^speaker: Itsuki","/#","^...","\n","^Then... see you tomorrow, Chef Tan.","\n","#","^speaker: Chef Tan","/#","^That's the spirit! Tomorrow, kid!","\n","#","^speaker: Itsuki","/#","ev",false,"/ev",{"VAR=":"Happy","re":true},"ev",true,"/ev",{"VAR=":"Depressed","re":true},"^...(I'm sorry, old man.)","\n","^(There's no tomorrow for me.)","\n","ev","str","^quest_another_day","/str",{"x()":"SetFlag","exArgs":1},"pop","/ev","\n","#","^speaker: Itsuki","/#","^Start another day.","\n","^That's what normal people do, right?","\n","^Wake up. Wash up. Pretend.","\n","^I can pretend for one more evening.","\n","ev","str","^quest_another_day_done","/str",{"x()":"SetFlag","exArgs":1},"pop","/ev","\n",{"->":"case1_goHome_done"},{"#f":1}],"case1_goHome_done":["#","^speaker: Itsuki","/#","^(Home.)","\n","^(This tiny room.)","\n","^(The only thing waiting for me is the hum of the fridge.)","\n",{"->":"rooftop"},{"#f":1}],"rooftop":[["ev","str","^quest_rooftop","/str",{"x()":"SetFlag","exArgs":1},"pop","/ev","\n","#","^speaker: Itsuki","/#","^The elevator's dead again.","\n","^Of course.","\n","^Emergency stairs, then.","\n","^One flight.","\n","^Two flights.","\n","^My legs remember this. Overtime taught them well.","\n","#","^speaker: Itsuki","/#","^...The door's open.","\n","^The roof.","\n","#","^speaker: Itsuki","/#","^The city is so loud from down there.","\n","^Up here...","\n","^...it's just wind.","\n","ev","str","^quest_rooftop_done","/str",{"x()":"SetFlag","exArgs":1},"pop","/ev","\n","ev","str","^quest_last_words","/str",{"x()":"SetFlag","exArgs":1},"pop","/ev","\n","#","^speaker: Itsuki","/#","^Mom. Dad.","\n","^You always told me —","\n","^work hard, be kind, and everything will turn out fine.","\n","^I worked hard.","\n","^I was kind.","\n","^So why...","\n","^why am I standing here?","\n","#","^speaker: Itsuki","/#","^Takumi...","\n","^My little brother.","\n","^The last time you called me \"big brother\" was at the funeral.","\n","^After that, you looked at me like I was a stranger.","\n","^Like I was the reason they were gone.","\n","^...","\n","^Maybe I was.","\n","^Maybe if I had come home earlier that night.","\n","^Maybe if I had picked up the phone—","\n","#","^speaker: Itsuki","/#","^Chef Tan.","\n","^You were the only one who ever asked if I had slept.","\n","^You offered me a tomorrow.","\n","^I'm sorry.","\n","^I won't be there for the soup recipe.","\n","#","^speaker: Itsuki","/#","^Six years of overtime.","\n","^And the only thing in my mailbox is a layoff letter.","\n","^The only thing on my phone is a missed call.","\n","^The only thing in my future is...","\n","^...this.","\n","^Just this.","\n","#","^speaker: Itsuki","/#","^Everything was supposed to be just as it should be.","\n","^Work hard. Be kind. Get rewarded.","\n","^Who wrote that rule?","\n","^Who wrote it...","\n","^and why did I believe it until the very end?","\n","#","^speaker: Itsuki","/#","^...","\n","^It's quiet.","\n","^No keyboards. No boss. No alarm clocks.","\n","^No tomorrow.","\n","^For the first time in six years...","\n","^it's quiet.","\n","ev","str","^Look at the city one last time","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Hold your parents' watch","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["^ ",{"->":"rooftop_city"},"\n",{"#f":5}],"c-1":["^ ",{"->":"rooftop_watch"},"\n",{"#f":5}]}],{"#f":1}],"rooftop_city":["#","^speaker: Itsuki","/#","^All those lights.","\n","^Every window is somebody's whole world.","\n","^None of them know I'm up here.","\n","^None of them will remember me by morning.","\n","^...","\n","^That's okay.","\n","^I was tired of being a stranger anyway.","\n",{"->":"rooftop_end"},{"#f":1}],"rooftop_watch":["#","^speaker: Itsuki","/#","^Dad's old watch.","\n","^It stopped the day he did.","\n","^Tick... tick... tick...","\n","^...Silence.","\n","^I guess we finally match, Dad.","\n",{"->":"rooftop_end"},{"#f":1}],"rooftop_end":["#","^speaker: Itsuki","/#","ev",true,"/ev",{"VAR=":"Traumatized","re":true},"^For the first time,","\n","^the wind doesn't feel cold.","\n","^It feels...","\n","^...like hands.","\n","^Like someone saying,","\n","^\"You did well. You can rest now.\"","\n","#","^speaker: Itsuki","/#","^...","\n","^Goodbye.","\n","^I'm sorry.","\n","^And thank you...","\n","^for every bowl of ramen.","\n","^For every small kindness.","\n","^For trying.","\n","ev","str","^quest_last_words_done","/str",{"x()":"SetFlag","exArgs":1},"pop","/ev","\n","ev","str","^prologue_ended","/str",{"x()":"SetFlag","exArgs":1},"pop","/ev","\n","ev","str","^inner_self","/str","/ev",{"VAR=":"nextBranch","re":true},"end",{"#f":1}],"global decl":["ev",false,{"VAR=":"Happy"},false,{"VAR=":"Confident"},false,{"VAR=":"Neutral"},false,{"VAR=":"Afraid"},false,{"VAR=":"Sad"},false,{"VAR=":"Depressed"},false,{"VAR=":"Traumatized"},"str","^","/str",{"VAR=":"nextBranch"},"/ev","end",null],"#f":1}],"listDefs":{}}